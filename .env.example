# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# TanStack Start server configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY

# Public Meta callback handled by this TanStack application
META_WEBHOOK_PUBLIC_URL=https://wa.alazab.com/api/public/webhooks/meta/whatsapp

# Optional emergency Meta fallback. Normal production credentials belong in Vault
# and are resolved through backend_resolve_meta_token.
META_SYSTEM_USER_TOKEN=

# Media worker / cron authentication
LOVABLE_CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
LOVABLE_CRON_SECRET_PREVIOUS=

# Legacy UI is disabled in production by default.
VITE_ENABLE_LEGACY_UI=false

# Legacy Finance Edge Functions are NOT part of the production web runtime yet.
# Keep their secrets out of this file unless those functions are deliberately
# migrated and deployed against the Organization-based schema.
